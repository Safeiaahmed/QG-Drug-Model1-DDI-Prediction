# Normalize drug names
mechanism_df['Drug'] = mechanism_df['Drug'].str.strip().str.lower()

# Parse targets into sets
def parse_targets(t):
    if pd.isna(t):
        return set()
    return set(x.strip().lower() for x in str(t).split('/'))


# Build drug → targets mapping
drug_to_targets = {
    row['Drug']: parse_targets(row['Target'])
    for _, row in mechanism_df.iterrows()
}


print("Data loaded:")
print(f"Drugs: {len(drug_df)}")
print(f"DDI interactions: {len(ddi_df)}")
ddi_df['Drug1_norm'] = ddi_df['Drug1'].str.strip().str.lower()
ddi_df['Drug2_norm'] = ddi_df['Drug2'].str.strip().str.lower()
severity_map = {'mild': 0, 'moderate': 1, 'severe': 2}
ddi_df = ddi_df[ddi_df['Severity'].str.lower().isin(severity_map)]
ddi_df['label'] = ddi_df['Severity'].str.lower().map(severity_map)

#  Encode Drugs and Build Graph Data
from sklearn.preprocessing import LabelEncoder
import torch
import torch.nn.functional as F
le = LabelEncoder()
# Combine all drugs from DDI and drug list
ddi_drugs = pd.unique(ddi_df[['Drug1', 'Drug2']].values.ravel())
node_drugs = pd.unique(drug_df['Drug'].dropna().values.ravel())
all_drugs = pd.unique(pd.Series(list(ddi_drugs) + list(node_drugs))).astype(str)

le.fit(all_drugs)  # Fit on the full drug list
drug_to_idx = {name: idx for idx, name in enumerate(le.classes_)}
idx_to_drug = {v: k for k, v in drug_to_idx.items()}
n_drugs = len(drug_to_idx)


drug_to_idx = {name: idx for idx, name in enumerate(le.classes_)}
idx_to_drug = {v: k for k, v in drug_to_idx.items()}
n_drugs = len(drug_to_idx)


# TARGET FEATURES

all_targets = sorted(set(
    t for targets in drug_to_targets.values()
    for t in targets
))

target_to_idx = {
    t:i for i,t in enumerate(all_targets)
}

target_features = torch.zeros(
    (n_drugs, len(all_targets))
)

for drug, idx in drug_to_idx.items():

    targets = drug_to_targets.get(
        drug.lower(),
        set()
    )

    for t in targets:

        if t in target_to_idx:

            target_features[
                idx,
                target_to_idx[t]
            ] = 1

print(
    "Target features shape:",
    target_features.shape
)



# MECHANISM EMBEDDINGS

from sentence_transformers import SentenceTransformer

embedder = SentenceTransformer(
    'all-MiniLM-L6-v2'
)

mechanisms = []

for drug in le.classes_:

    row = mechanism_df[
        mechanism_df['Drug']
        .str.lower()
        == drug.lower()
    ]

    if not row.empty:

        mechanisms.append(
            str(row['Mechanism'].values[0])
        )

    else:

        mechanisms.append(
            "unknown mechanism"
        )

mech_embeddings = torch.tensor(
    embedder.encode(mechanisms),
    dtype=torch.float
)

print(
    "Mechanism embedding shape:",
    mech_embeddings.shape
)


# Disease SUBTYPE FEATURES
subtypes = sorted(
    disease_edges[
        'Disease_Subtype'
    ].dropna().unique()
)

subtype_to_idx = {
    s:i for i,s in enumerate(subtypes)
}

subtype_features = torch.zeros(
    (
        n_drugs,
        len(subtypes)
    )
)

for _, row in disease_edges.iterrows():

    prescribed = str(
        row['Prescribed']
    ).strip().lower()

    if prescribed == 'yes':

        drug = str(
            row['Drug']
        ).strip()

        subtype = row[
            'Disease_Subtype'
        ]

        if drug in drug_to_idx:

            subtype_features[
                drug_to_idx[drug],
                subtype_to_idx[subtype]
            ] = 1

print(
    "Subtype feature shape:",
    subtype_features.shape
)



# FINAL DRUG FEATURES
x = torch.cat([
    target_features,
    mech_embeddings,
    subtype_features
], dim=1)
x = F.normalize(x, p=2, dim=1)
print(
    "Final feature matrix shape:",
    x.shape
)


severity_map = {'mild': 0, 'moderate': 1, 'severe': 2}
ddi_df = ddi_df[ddi_df['Severity'].str.lower().isin(severity_map)]
ddi_df['label'] = ddi_df['Severity'].str.lower().map(severity_map)

edge_index = torch.tensor([[drug_to_idx[r['Drug1']], drug_to_idx[r['Drug2']]] for _, r in ddi_df.iterrows()], dtype=torch.long).t()
from torch_geometric.utils import to_undirected

edge_index = to_undirected(
    edge_index
)
edge_labels = torch.tensor(ddi_df['label'].values, dtype=torch.long)



#  Build PyG Graph
from torch_geometric.data import Data
data = Data(x=x, edge_index=edge_index, edge_label=edge_labels)


#  Define GNN Model
import torch.nn as nn
import torch.nn.functional as F
from torch_geometric.nn import GATConv
import torch.nn.functional as F
import torch.nn as nn

class GNNLinkClassifier(nn.Module):

    def __init__(
        self,
        in_channels,
        hidden_channels,
        num_classes
    ):
        super().__init__()

        self.bn1 = nn.BatchNorm1d(hidden_channels)
        self.bn2 = nn.BatchNorm1d(hidden_channels)
        self.bn3 = nn.BatchNorm1d(hidden_channels)

        self.conv1 = GATConv(
            in_channels,
            hidden_channels,
            heads=8,
            concat=False,
            dropout=0.2
        )

        self.conv2 = GATConv(
            hidden_channels,
            hidden_channels,
            heads=8,
            concat=False,
            dropout=0.2
        )

        self.conv3 = GATConv(
            hidden_channels,
            hidden_channels,
            heads=8,
            concat=False,
            dropout=0.2
        )

        self.conv4 = GATConv(
            hidden_channels,
            hidden_channels,
            heads=8,
            concat=False,
            dropout=0.2
        )

        self.classifier = nn.Sequential(
            nn.Linear(
                hidden_channels * 4,
                128
            ),
            nn.ReLU(),

            nn.Dropout(0.3),

            nn.Linear(
                128,
                64
            ),
            nn.ReLU(),

            nn.Dropout(0.2),

            nn.Linear(
                64,
                num_classes
            )
        )


    def forward(self, x, edge_index, edge_pairs):

        h1 = F.relu(self.bn1(self.conv1(x, edge_index)))
        h2 = F.relu(self.bn2(self.conv2(h1, edge_index)))
        h3 = F.relu(self.bn3(self.conv3(h2, edge_index)))
        h4 = self.conv4(h3, edge_index)

        x = h1 + h2 + h3 + h4

        src = x[edge_pairs[0]]
        dst = x[edge_pairs[1]]

        edge_features = torch.cat([
            src,
            dst,
            torch.abs(src - dst),
            src * dst
        ], dim=1)

        return self.classifier(edge_features)



from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, f1_score, classification_report

# Hold out known DDIs for evaluation
known_ddi_pairs = ddi_df[['Drug1', 'Drug2']].apply(lambda row: tuple(sorted(row)), axis=1)
ddi_df['pair'] = known_ddi_pairs

# Hold out 10% of known DDIs for evaluation
train_ddi_df, heldout_ddi_df = train_test_split(ddi_df, test_size=0.1, stratify=ddi_df['label'], random_state=42)

# Build graph from training DDIs only
edge_index = torch.tensor(
    [[drug_to_idx[r['Drug1']], drug_to_idx[r['Drug2']]] for _, r in train_ddi_df.iterrows()],
    dtype=torch.long
).t()

edge_labels = torch.tensor(train_ddi_df['label'].values, dtype=torch.long)

data = Data(x=x, edge_index=edge_index, edge_label=edge_labels)


from torch_geometric.utils import add_self_loops

edge_index, _ = add_self_loops(edge_index)

# Train/Test Split
from sklearn.model_selection import train_test_split

edges = data.edge_index.t().numpy()
labels = data.edge_label.numpy()
train_idx, test_idx = train_test_split(range(len(edges)), test_size=0.2, stratify=labels, random_state=42)
train_edges = torch.tensor(edges[train_idx].T, dtype=torch.long)
test_edges = torch.tensor(edges[test_idx].T, dtype=torch.long)
train_labels = torch.tensor(labels[train_idx], dtype=torch.long)
test_labels = torch.tensor(labels[test_idx], dtype=torch.long)


# Train the GNN
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
model = GNNLinkClassifier(in_channels=x.size(1), hidden_channels=128, num_classes=3).to(device)

optimizer = torch.optim.AdamW(
    model.parameters(),
    lr=0.0005,
    weight_decay=5e-4
)
scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
    optimizer,
    factor=0.5,
    patience=20
)
from sklearn.utils.class_weight import compute_class_weight
import numpy as np

weights = compute_class_weight(
    class_weight='balanced',
    classes=np.array([0,1,2]),
    y=train_labels.numpy()
)

weights = torch.tensor(
    weights,
    dtype=torch.float
).to(device)

loss_fn = nn.CrossEntropyLoss(
    weight=weights,
    label_smoothing=0.1
)

print("Class weights:", weights)

model.train()
best_loss = 1e9
patience = 30
counter = 0

best_loss = float("inf")
patience = 30
counter = 0

for epoch in range(500):

    optimizer.zero_grad()

    out = model(
        data.x.to(device),
        data.edge_index.to(device),
        train_edges.to(device)
    )

    loss = loss_fn(
        out,
        train_labels.to(device)
    )

    loss.backward()
    torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
    optimizer.step()
    scheduler.step(loss)

    if loss.item() < best_loss:
        best_loss = loss.item()
        counter = 0
        torch.save(model.state_dict(), "best_model.pt")
    else:
        counter += 1

    if counter >= patience:
        print("Early stopping")
        break

    if epoch % 20 == 0:
        print(f"Epoch {epoch:03d} | Loss: {loss.item():.4f}")

model.load_state_dict(torch.load("best_model.pt"))

# Predict Missing Interactions
from itertools import combinations

known_pairs = set(map(tuple, map(sorted, ddi_df[['Drug1','Drug2']].values.tolist())))
possible_pairs = list(combinations(le.classes_, 2))
missing_pairs = [p for p in possible_pairs if tuple(sorted(p)) not in known_pairs]

missing_edge_index = torch.tensor([[drug_to_idx[p[0]], drug_to_idx[p[1]]] for p in missing_pairs], dtype=torch.long).t()

with torch.no_grad():
    pred_logits = model(data.x.to(device), data.edge_index.to(device), missing_edge_index.to(device))
    pred_classes = pred_logits.argmax(dim=1).cpu().tolist()

predicted_ddis = [(p[0], p[1], ['mild','moderate','severe'][c]) for p, c in zip(missing_pairs, pred_classes)]
missing_pred_classes = pred_logits.argmax(dim=1).cpu().tolist()
predicted_ddis = [
    (p[0], p[1], ['mild','moderate','severe'][c])
    for p, c in zip(missing_pairs, missing_pred_classes)
]

# Convert held-out test set to edge pairs
heldout_edge_index = torch.tensor(
    [[drug_to_idx[row['Drug1']], drug_to_idx[row['Drug2']]] for _, row in heldout_ddi_df.iterrows()],
    dtype=torch.long
).t()

heldout_labels = torch.tensor(heldout_ddi_df['label'].values, dtype=torch.long)

# Predict on held-out
model.eval()
with torch.no_grad():
    preds = model(data.x.to(device), data.edge_index.to(device), heldout_edge_index.to(device))
    pred_classes = preds.argmax(dim=1).cpu()

# Evaluation
accuracy = accuracy_score(heldout_labels, pred_classes)
f1 = f1_score(heldout_labels, pred_classes, average='weighted')
print(f"\n Evaluation on Held-out DDIs:")
print(f" Accuracy: {accuracy:.4f}")
print(f" F1 Score (weighted): {f1:.4f}")
print("\n Detailed Classification Report:")
print(classification_report(
    heldout_labels,
    pred_classes,
    labels=[0, 1, 2],
    target_names=['mild', 'moderate', 'severe'],
    zero_division=0  # avoids division by zero errors
))

# Severity counts
from collections import Counter
pred_severity = Counter(['mild','moderate','severe'][c] for c in pred_classes)
print("\n Predicted Severity Breakdown:")
for severity, count in pred_severity.items():
    print(f"- {severity.capitalize()}: {count} predicted")
print(f"\n Total predicted held-out DDIs: {len(pred_classes)}")


#  Show Whole Graph
import networkx as nx
import matplotlib.pyplot as plt

G = nx.Graph()

# Add grouped subtypes
for _, row in disease_nodes.iterrows():
    subtype = row['Disease_Subtype'].strip('. ')
    group = row['grouped disease subtypes '].strip('. ')
    G.add_node(group, type='group', color='coral')
    G.add_node(subtype, type='subtype', color='green')
    G.add_edge(subtype, group, type='subtype-of', color='gray')

# Add drug nodes
for drug in drug_df['Drug'].dropna():
    drug = drug.strip()
    G.add_node(drug, type='drug', color='blue')

# Add mechanism annotations
for _, row in mechanism_df.iterrows():
    drug = row['Drug'].strip()
    if drug in G.nodes:
        G.nodes[drug]['mechanism'] = row['Mechanism']

# Add prescription edges
for _, row in disease_edges.iterrows():
    drug = row['Drug'].strip()
    subtype = row['Disease_Subtype'].strip()
    prescribed = str(row['Prescribed']).strip().lower() == 'yes'
    color = 'green' if prescribed else 'red'
    label = 'prescribed' if prescribed else 'not_prescribed'
    if drug in G.nodes and subtype in G.nodes:
        G.add_edge(drug, subtype, type=label, color=color)


# Add DDI edges
for d1, d2, severity in predicted_ddis:
    if d1 in G.nodes and d2 in G.nodes:
        color = {'mild': 'blue', 'moderate': 'orange', 'severe': 'red'}.get(severity, 'gray')
        G.add_edge(d1, d2, type='ddi', color=color, severity=severity)

plt.figure(figsize=(24, 18))
pos = nx.spring_layout(G, seed=42)
colors = [G.nodes[n].get('color', 'gray') for n in G.nodes()]
edge_colors = [G[u][v]['color'] for u,v in G.edges()]
nx.draw(G, pos, with_labels=True, node_color=colors, edge_color=edge_colors, node_size=500, font_size=7)
plt.title("DDI Knowledge Graph")
plt.axis('off')
plt.show()


def common_targets(drug_a, drug_b):
    t1 = drug_to_targets.get(drug_a.lower(), set())
    t2 = drug_to_targets.get(drug_b.lower(), set())
    return t1.intersection(t2)


# Interactive Dropdown
import ipywidgets as widgets
from IPython.display import display

dropdown = widgets.Dropdown(
    options=sorted(drug_to_idx.keys()),
    description='Drug:',
    disabled=False,
)
display(dropdown)
button = widgets.Button(description="Run Prediction")
output = widgets.Output()

def on_button_clicked(b):
    with output:
        output.clear_output()
        drug_input = dropdown.value
        drug_input_norm = drug_input.strip().lower()
        subtype_matches = disease_edges[
            (disease_edges['Drug'].str.strip().str.lower() == drug_input_norm) &
            (disease_edges['Prescribed'].str.strip().str.lower() == 'yes')
        ]

        if not subtype_matches.empty:
            print(f"\n Prescribed specified Subtypes for {drug_input}:")
            for _, row in subtype_matches.iterrows():
                subtype = row['Disease_Subtype'].strip()
                note = row['Note'] if 'Note' in row else ''
                print(f"- {subtype}: {note}")
        else:
            print(f"\n {drug_input} is not prescribed for any specified subtype.")

        drug_input_norm = drug_input.strip().lower()
        #  Mechanism of action
        moa_row = mechanism_df[mechanism_df['Drug'].str.lower() == drug_input.lower()]
        if not moa_row.empty:
            print(f" Mechanism of Action for {drug_input}:")
            print(moa_row['Mechanism'].values[0])
        else:
            print(f" Mechanism of Action for {drug_input}: Not available.")

        print(f"\n Predicted combinations for '{drug_input}':")

        related = []
                #  Get list of drugs from the same disease subtype(s)
        subtype_drugs = set()
        for subtype in subtype_matches['Disease_Subtype'].unique():
            subtype_drug_rows = disease_edges[
                (disease_edges['Disease_Subtype'] == subtype) &
                (disease_edges['Prescribed'].str.strip().str.lower() == 'yes')
            ]
            subtype_drugs.update(subtype_drug_rows['Drug'].str.strip())


        # Add predicted DDIs
        for (d1, d2), s in zip(missing_pairs, missing_pred_classes):
            if drug_input in (d1, d2):
                other = d2 if d1 == drug_input else d1
                related.append((other, s, "Predicted interaction (no known note)"))

        # Add known DDIs from ddi_df
        drug_input_norm = drug_input.strip().lower()
        matches = ddi_df[
            (ddi_df['Drug1_norm'] == drug_input_norm) | (ddi_df['Drug2_norm'] == drug_input_norm)
        ]

        for _, row in matches.iterrows():
            other = row['Drug2'] if row['Drug1_norm'] == drug_input_norm else row['Drug1']
            label = int(row['label'])
            interaction_note = row['Interaction'] if 'Interaction' in row and pd.notna(row['Interaction']) else "No interaction note available"
            related.append((other.strip(), label, interaction_note))

        #  KEEP ALL — DO NOT deduplicate or override
        # Separate into safe and risky
        safe = []
        risky = []

        for d, s, note in related:
            s_int = int(s)

            #  check common targets
            shared = common_targets(drug_input, d)

            if shared:
                risky.append((
                    d,
                    2,
                    f"Risky combination due to shared target(s): {', '.join(shared)}"
                ))
            else:
                if s_int == 0:
                    safe.append((d, note))
                else:
                    risky.append((d, s_int, note))


        # Show recommendation based only on same-subtype drugs
        print("\n Drug Combination Recommendations Within Same Subtypes:")
        same_safe = []
        same_risky = []

        for d, s, note in related:
            if d.strip() in subtype_drugs:
                if s == 0:
                    same_safe.append((d, note))
                else:
                    same_risky.append((d, s, note))

        print("\n Safe combinations (within same subtypes):")
        if same_safe:
            for d, note in same_safe:
                print(f"- {d}: {note}")
        else:
            print("- None found.")

        print("\n Risky combinations (within same subtypes):")
        if same_risky:
            for d, s, note in same_risky:
                severity = ['mild', 'moderate', 'severe'][s]
                print(f"- {d} (severity: {severity}): {note}")
        else:
            print("- None found.")

        print("\n Drug Combinations Recommendations Regarding All DrugBank Approved drugs:")


        #  Safe
        print("\n Recommended and Safe to combine (mild):")
        if safe:
            for d, note in safe:
                print(f"- {d}: {note}")
        else:
            print("- None found.")

        #  Risky
        print("\n Risky to combine:")
        if risky:
            for d, s_int, note in risky:
                severity = ['mild', 'moderate', 'severe'][s_int]
                print(f"- {d} (severity: {severity}): {note}")
        else:
            print("- None found.")

        #  Visualize
        G = nx.Graph()
        G.add_node(drug_input)
        for d, s, _ in related:
            G.add_node(d)
            color = {0: 'blue', 1: 'orange', 2: 'red'}.get(int(s), 'gray')
            label = ['mild', 'moderate', 'severe'][int(s)]
            G.add_edge(drug_input, d, color=color, label=label)

        pos = nx.spring_layout(G, seed=42)
        edges = G.edges()
        edge_colors = [G[u][v]['color'] for u, v in edges]

        plt.figure(figsize=(10, 7))
        nx.draw(G, pos, with_labels=True, edge_color=edge_colors, node_color='lightblue', node_size=1000, font_size=9)
        nx.draw_networkx_edge_labels(G, pos, edge_labels={(u, v): G[u][v]['label'] for u, v in edges}, font_size=8)
        plt.title(f"All Known and Predicted DDI Interactions for {drug_input}")
        plt.axis('off')
        plt.show()


button.on_click(on_button_clicked)
display(button, output)
